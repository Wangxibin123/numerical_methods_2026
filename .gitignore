# Raw NYC TLC parquet data (too large for git)
data/raw/*.parquet
data/raw/*.csv
data/raw/*.zip

# Intermediate cleaned parquet (151 MB; can be regenerated by `make data`)
data/processed/*.parquet

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv

# Beamer rendered slides (regenerated from PDF)
slides/rendered/*.png

# PowerPoint temp files
~$*.pptx
~$*.docx

# Video binary
video/*.mp4
video/*.mov

# Allow .gitkeep
!**/.gitkeep
